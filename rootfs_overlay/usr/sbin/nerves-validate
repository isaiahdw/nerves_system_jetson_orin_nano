#!/bin/sh
#
# Mark the running firmware good: fwup's validate task sets
# nerves_fw_validated=1 (gates upgrades and reverts) and writes GRUB's
# saved_entry to the running slot, closing the one-shot next_entry
# window the upgrade opened.
#
# Call this from the application ONLY after real health checks pass:
# until it runs, a reboot or crash falls back to the previous slot.

PATH=/usr/sbin:/usr/bin:/sbin:/bin

exec fwup -a -t validate -d /dev/rootdisk0 --enable-trim -i /usr/share/fwup/ops.fw -q -U
