BR2_aarch64=y
BR2_cortex_a78=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/nerves-project/toolchains/releases/download/v15.3.0/nerves_toolchain_aarch64_nerves_linux_gnu-linux_${shell uname -m}-15.3.0-8DAF9F3.tar.xz"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="aarch64-nerves-linux-gnu"
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_0=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_GLIBC=y
# BR2_TOOLCHAIN_EXTERNAL_INET_RPC is not set
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TOOLCHAIN_EXTERNAL_FORTRAN=y
BR2_TOOLCHAIN_EXTERNAL_OPENMP=y
BR2_TAR_OPTIONS="--no-same-owner"
BR2_BACKUP_SITE="https://dl.nerves-project.org"
BR2_GLOBAL_PATCH_DIR="${BR2_EXTERNAL_NERVES_PATH}/patches"
BR2_REPRODUCIBLE=y
BR2_ROOTFS_SKELETON_CUSTOM=y
BR2_ROOTFS_SKELETON_CUSTOM_PATH="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/skeleton"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_TABLE="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/device_table.txt"
BR2_ENABLE_LOCALE_WHITELIST="locale-archive"
BR2_GENERATE_LOCALE="en_US.UTF-8"
BR2_ROOTFS_OVERLAY="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/rootfs_overlay ${NERVES_DEFCONFIG_DIR}/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-build.sh ${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="${NERVES_DEFCONFIG_DIR}/post-createfs.sh"
BR2_LINUX_KERNEL=y
# NVIDIA's Jetson Linux r39.2 kernel (JetPack 7.2): the Ubuntu noble kernel
# tree with NVIDIA's Tegra patches, pinned to the commit meta-tegra master
# builds for L4T r39.2.0 (branch l4t/l4t-r39.2-Ubuntu-nvidia-tegra-6.8.0-1021.21,
# kernel 6.8.12). The NVIDIA out-of-tree modules (nvgpu etc.) are a separate,
# later package - this tree alone covers everything but the GPU.
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://gitlab.com/nvidia/nv-tegra/3rdparty/canonical/linux-noble/-/archive/78272943bba3a47e633b28963b0cda60de503500/linux-noble-78272943bba3a47e633b28963b0cda60de503500.tar.gz"
BR2_LINUX_KERNEL_PATCH="${NERVES_DEFCONFIG_DIR}/linux"
# arm64 defconfig plus the Nerves fragment (Tegra/NVMe/EFI built-in and
# Nerves requirements, documented inline).
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/linux/nerves.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# The upstream-style DT for the Orin Nano Developer Kit carrier (p3768) with
# the Orin Nano devkit module (p3767-0005). There is no in-tree DT for the
# 4GB production module (p3767-0004) or the Waveshare carrier; this is the
# closest match and RAM size comes from firmware, not the DT. The extlinux
# configs also carry a no-FDT entry that boots on the UEFI-provided DT
# instead. The .dtb basename must match the devicetree.dtb resource in
# fwup.conf.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="nvidia/tegra234-p3768-0000+p3767-0005"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_CONFIG="${BR2_EXTERNAL_NERVES_PATH}/board/nerves-common/busybox.config"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="${NERVES_DEFCONFIG_DIR}/busybox.fragment"
BR2_PACKAGE_F2FS_TOOLS=y
# resizepart, used by /usr/sbin/expand-app-fs to grow the data partition
# on the first boot after an image flash.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
# efibootmgr/efivar for inspecting the UEFI boot state during bring-up.
# Slot switching itself goes through nvbootctrl (packaged at M2).
BR2_PACKAGE_EFIVAR=y
BR2_PACKAGE_EFIBOOTMGR=y
# sgdisk: L4TLauncher selects the boot partition by GPT name (APP), and
# bring-up on a machine whose stock NVMe also has an APP partition means
# renaming that partition and being able to rename it back from here -
# the stock OS cannot boot while renamed, so the tool must live in this
# image, not there.
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
# nvbootctrl: marks boots successful so the UEFI retry counters reset
# (nerves-boot-success runs it from erlinit every boot). host-zstd is
# pulled in as its extract dependency.
BR2_PACKAGE_NVBOOTCTRL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_DTC=y
BR2_PACKAGE_LIBMNL=y
BR2_PACKAGE_WIRELESS_REGDB=y
# RTL8822CE WiFi firmware for mainline rtw88 (rtw88/rtw8822c_fw.bin) and
# the matching Bluetooth blob for btrtl.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_WIRED=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_DEBUG_SYSLOG=y
BR2_PACKAGE_WPA_SUPPLICANT_WPS=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_NERVES_SYSTEM_NAME="nerves_system_jetson_orin_nano"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf ${NERVES_DEFCONFIG_DIR}/extlinux-a.conf ${NERVES_DEFCONFIG_DIR}/extlinux-b.conf ${NERVES_DEFCONFIG_DIR}/uefi/BOOTAA64.efi"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y
# Dynamic /dev: USB camera/audio/serial devices come and go on the robot.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
# ALSA userspace for the robot's USB audio board (mic + speaker).
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
