# Nerves additions on top of the arm64 defconfig (NVIDIA linux-noble 6.8).
#
# The arm64 defconfig already covers the Tegra234 SoC core: ARCH_TEGRA,
# clk/pinctrl/gpio, SERIAL_TEGRA, USB XHCI/Tegra, EFI + the arm64 EFI stub,
# SQUASHFS, VFAT. Entries here are either Tegra options the defconfig leaves
# as modules (root storage must be built in) or Nerves requirements.

# Console: the Tegra Combined UART (ttyTCU0) is the debug console shared
# with MB1/MB2/UEFI.
CONFIG_SERIAL_TEGRA_TCU=y
CONFIG_SERIAL_TEGRA_TCU_CONSOLE=y

# Root storage: squashfs rootfs on an NVMe partition behind the Tegra234
# PCIe controller (tegra194 driver generation) - all built in, the rootfs
# cannot be reached from modules.
CONFIG_PCIE_TEGRA194=y
CONFIG_PCIE_TEGRA194_HOST=y
CONFIG_PHY_TEGRA194_P2U=y
CONFIG_BLK_DEV_NVME=y

# Gigabit ethernet on the carrier is a Realtek PCIe NIC.
CONFIG_R8169=y
CONFIG_REALTEK_PHY=y

# efivarfs: the rootfs A/B slot state lives in UEFI variables
# (RootfsStatusSlotA/B); nvbootctrl and the bring-up tooling read them here.
CONFIG_EFIVAR_FS=y

# The 40-pin header UARTs (ttyTHS1/THS2, 3100000.serial and friends).
CONFIG_SERIAL_TEGRA=y

# Denver/Tegra watchdog, armed by Erlang heart; must not be disarmable.
CONFIG_TEGRA_WATCHDOG=y
CONFIG_WATCHDOG_NOWAYOUT=y

# Reboot 10s after a kernel panic (alongside the heart-armed watchdog)
CONFIG_PANIC_TIMEOUT=10

# Scale CPU clocks with load instead of pinning 1.73 GHz (the arm64
# defconfig defaults to the performance governor) - this system's
# devices typically run on battery.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# The NVIDIA out-of-tree modules (package/nvidia-oot) inherit the
# kernel's warnings-as-errors and their peripheral drivers don't build
# clean under it; NVIDIA's own kernels ship with WERROR off.
# CONFIG_WERROR is not set

# Nerves devices must never sleep
# CONFIG_SUSPEND is not set

# The application data partition is f2fs
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# squashfs compression + read performance (mksystem.sh compresses with xz)
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y

# EROFS rootfs (Nerves 2.0 rootfs_type: :erofs). Built in like squashfs:
# the rootfs cannot be reached from modules. lz4 compression only - zstd
# EROFS needs kernel 6.10+, this tree is 6.8.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_ZIP=y

# TUN/TAP built in: standard Nerves expectation (VPNs, overlay networks)
CONFIG_TUN=y

# vintage_net's RouteManager uses policy routing. IP_ADVANCED_ROUTER is
# required for IP_MULTIPLE_TABLES to take effect.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Generic Nerves niceties (cf. official systems)
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_OF_OVERLAY=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Common USB peripherals, all fine as modules (loaded after rootfs):
# UVC cameras, USB audio, CDC-ACM devices, and USB-serial bridges.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_EXFAT_FS=m

# FAT short-name codepage for western-European USB sticks; erlinit mounts
# FAT with iocharset=ascii.
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_ASCII=y

# WiFi/BT: Realtek RTL8822CE on the M.2 Key-E slot (PCIe WLAN 10ec:c822,
# USB BT 0bda:c822 - see docs/recon.md). The stock image uses Realtek's
# out-of-tree rtl88x2ce; mainline rtw88 drives the same part and needs
# rtw88/rtw8822c_fw.bin from linux-firmware (selected in nerves_defconfig).
# cfg80211/mac80211 stay =m from the defconfig.
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
# Bluetooth over btusb/btrtl (firmware blob also from linux-firmware).
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_RTL=y
