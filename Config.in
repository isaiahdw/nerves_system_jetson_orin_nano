# Custom Buildroot packages for this system. The NVIDIA out-of-tree
# kernel modules (nvidia-oot/nvgpu) and the CUDA/TensorRT userland
# arrive as further package/<name>/ entries sourced here.
source "$NERVES_DEFCONFIG_DIR/package/nvidia-oot/Config.in"
source "$NERVES_DEFCONFIG_DIR/package/tegra-libs/Config.in"
source "$NERVES_DEFCONFIG_DIR/package/tensorrt-runtime/Config.in"
