# Additional configuration for erlinit
#
# To override the settings in this file, see
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config.
#

# Turn on the debug prints
#-v

# IEx on the Tegra Combined UART (115200, shared with MB1/MB2/UEFI; the
# carrier's debug UART pin header). Never move the console to the 40-pin
# header UART - derived systems may attach hardware there.
-c ttyTCU0

# If more than one tty are available, always warn if the user is looking at the
# wrong one.
--warn-unused-tty

# Use nbtty to improve terminal handling on serial ports.
-s "/usr/bin/nbtty"

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the application data partition (run "man fstab" for field names).
# NOTE: This must match the location in fwup.conf. The active slot's FAT
# boot partition (p2 or p3; p1 is the ESP) is deliberately not mounted:
# which one is active is boot-chain state that a static fstab line cannot
# follow, and nothing at runtime needs the boot files.
-m /dev/nvme0n1p6:/root:f2fs:nodev:
# efivarfs: the rootfs A/B slot state lives in UEFI variables;
# nerves-uefi-sync and the M2 tooling read and write them here.
-m efivarfs:/sys/firmware/efi/efivars:efivarfs:nodev,noexec,nosuid:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu

# Grow the data partition to fill the NVMe on the first boot after an
# image flash (no-op once expanded - see the script).
--pre-run-exec /usr/sbin/expand-app-fs

# Tell the boot firmware this boot made it: resets the UEFI boot-retry
# counters that otherwise latch the chain Unbootable after 3 boots.
--pre-run-exec /usr/sbin/nerves-boot-success

# Erlang release search path
-r /srv/erlang

# Assign a hostname of the form "nerves-<last 4 chars of the serial number>".
# See /etc/boardid.config for locating the serial number.
-d /usr/bin/boardid
-n nerves-%-.4s

# If using shoehorn (https://github.com/nerves-project/shoehorn), start the
# shoehorn OTP release up first. If shoehorn isn't around, erlinit fails back
# to the main OTP release.
--boot shoehorn
